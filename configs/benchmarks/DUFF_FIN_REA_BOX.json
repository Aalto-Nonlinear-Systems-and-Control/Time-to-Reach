{
  "$schema": "../schema/benchmark.schema.json",
  "id": "DUFF_FIN_REA_BOX",
  "description": "Duffing oscillator, finite horizon, reachable, box sets.",
  "system": {
    "type": "nonlinear",
    "equations": ["x2", "-0.5*x2 - x1*(x1^2-1)"]
  },
  "domain": [
    [-1.0, 1.9],
    [-1.2, 2.0]
  ],
  "initial_sets": [
    {
      "type": "box",
      "bounds": [
        [-0.8, -0.7],
        [1.3, 1.39]
      ]
    }
  ],
  "target_sets": [
    {
      "type": "box",
      "bounds": [
        [0.7, 0.8],
        [0.178, 0.3]
      ]
    }
  ],
  "time_horizon": [0.0, 6],
  "expected_result": "reachable",
  "visualization": {
    "dims": [
      [0, 1]
    ]
  }
}
