{
  "$schema": "../schema/benchmark.schema.json",
  "id": "DUFF_FIN_REA_NONCONVEX_LEVEL_SET",
  "description": "Duffing oscillator, finite horizon, reachable, nonconvex level-set initial and target sets.",
  "system": {
    "type": "nonlinear",
    "equations": ["x2", "-0.5*x2 - x1*(x1^2-1)"]
  },
  "domain": [
    [-1.0, 1.7],
    [-1.2, 2.2]
  ],
  "initial_sets": [
    {
      "type": "level_set",
      "function": "-(1-(x1-(-0.75))/3+1*((x2-1.85)/0.05)^5+2*((x1-(-0.75))/0.05)^3)*exp(-(((x1-(-0.75))/0.05)^2+((x2-1.85)/0.05)^2))+0.01",
      "bounding_box": [
        [-1, -0.3],
        [1.5, 2.2]
      ]
    }
  ],
  "target_sets": [
    {
      "type": "level_set",
      "function": "-(1-(x1-0.65)/3+3*((x2-0.25)/0.1)^5+4*((x1-0.65)/0.1)^3)*exp(-(((x1-0.65)/0.1)^2+((x2-0.25)/0.1)^2))+0.9",
      "bounding_box": [
        [0.5, 1],
        [0, 0.5]
      ]
    }
  ],
  "time_horizon": [0.0, 6],
  "expected_result": "reachable",
  "visualization": {
    "dims": [
      [0, 1]
    ]
  }
}
