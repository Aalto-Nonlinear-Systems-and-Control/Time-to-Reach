{
  "$schema": "../schema/benchmark.schema.json",
  "id": "NL_SLC_FIN_UNR_BOX",
  "description": "Nonlinear system with a stable limit cycle (2D), finite horizon, unreachable, box sets.",
  "notes": ["The vector field is singular at the origin (division by x1^2 + x2^2); the origin is not an equilibrium."],
  "system": {
    "type": "nonlinear",
    "equations": ["(-x1^3 + 4*x1^2*x2 - x1*x2^2 + x1 + 4*x2^3) / (4*(x1^2 + x2^2))", "(-4*x1^3 - x1^2*x2 - 4*x1*x2^2 - x2^3 + x2) / (4*(x1^2 + x2^2))"]
  },
  "domain": [
    [-2.0, 2.0],
    [-2.0, 2.0]
  ],
  "initial_sets": [
    {
      "type": "box",
      "bounds": [
        [1.3, 1.4],
        [1.3, 1.4]
      ]
    }
  ],
  "target_sets": [
    {
      "type": "box",
      "bounds": [
        [0.475, 0.525],
        [0.475, 0.525]
      ]
    }
  ],
  "time_horizon": [0.0, 15],
  "expected_result": "unreachable",
  "visualization": {
    "dims": [
      [0, 1]
    ]
  }
}
