{
  "$schema": "../schema/benchmark.schema.json",
  "id": "DUFF_FIN_REA_DISJOINT_BOX",
  "description": "Duffing oscillator, finite horizon, reachable, target is a union of two disjoint boxes.",
  "system": {
    "type": "nonlinear",
    "equations": ["x2", "-0.5*x2 - x1*(x1^2-1)"]
  },
  "domain": [
    [-2.0, 2.0],
    [-2.0, 2.0]
  ],
  "initial_sets": [
    {
      "type": "box",
      "bounds": [
        [-0.8, -0.7],
        [1.8, 1.9]
      ]
    }
  ],
  "target_sets": [
    {
      "type": "box",
      "bounds": [
        [0.6, 0.7],
        [0.2, 0.3]
      ]
    },
    {
      "type": "box",
      "bounds": [
        [1.0, 1.1],
        [1.0, 1.1]
      ]
    }
  ],
  "time_horizon": [0.0, 6],
  "expected_result": "reachable",
  "visualization": {
    "dims": [
      [0, 1]
    ]
  }
}
